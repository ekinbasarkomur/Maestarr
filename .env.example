# Maestarr is configured in its web UI. This file is only for startup values
# and for automated deployments: any variable below is a default that a value
# saved in the UI overrides.

# --- Startup (environment only) ---
MAESTARR_HOST=127.0.0.1
MAESTARR_PORT=8709
MAESTARR_DATA_DIR=data
MAESTARR_LOG_LEVEL=INFO

# --- AI model ---
# anthropic | openai | google | openrouter | ollama | openai-compat
# MAESTARR_LLM_PROVIDER=anthropic
# MAESTARR_MODEL=claude-sonnet-5-5
# MAESTARR_LLM_API_KEY=
# MAESTARR_MODEL_BASE_URL=          # Ollama / OpenAI-compatible servers

# --- *arr stack ---
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=
# WHISPARR_URL=http://whisparr:6969  # adult, optional
# WHISPARR_API_KEY=

# --- Download client ---
# QBITTORRENT_URL=http://qbittorrent:8080
# QBITTORRENT_USERNAME=
# QBITTORRENT_PASSWORD=

# --- Media server and metadata ---
# JELLYFIN_URL=http://jellyfin:8096
# JELLYFIN_API_KEY=
# TMDB_API_KEY=
# OMDB_API_KEY=
# TRAKT_CLIENT_ID=
# TRAKT_USERNAME=
# ANILIST_USERNAME=
# STASHDB_ENABLED=false             # adult, optional
# STASHDB_API_KEY=

# --- Telegram ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
